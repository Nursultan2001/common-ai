# NOTE: this file lives at the repo root for reference, but the app reads
# apps/web/.env (Prisma + Next both load env from there). Put your real values
# in apps/web/.env.

# ---- Database (PostgreSQL: Supabase or Neon) ----
# DATABASE_URL  = pooled connection (used by the app at runtime).
# DIRECT_URL    = direct connection (used by `prisma db push` / migrations).
#
# Supabase (Project Settings -> Database -> Connection string):
#   DATABASE_URL = pooler (port 6543), add ?pgbouncer=true&connection_limit=1
#   DIRECT_URL   = direct (port 5432)
# Example:
#   DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#   DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# Neon: you can use the same pooled URL for both.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ---- Auth ----
AUTH_SECRET="generate-with: openssl rand -base64 32"
APP_URL="http://localhost:3000"

# ---- Anthropic (AI content service) ----
ANTHROPIC_API_KEY="sk-ant-..."
AI_MODEL="claude-opus-4-8"

# ---- Stripe (per-application billing) ----
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PER_APPLICATION_CENTS="500"

# ---- Document vault encryption ----
# 32-byte base64 key for AES-256-GCM. Generate: openssl rand -base64 32
DOC_ENCRYPTION_KEY="..."
# Local document vault directory (swap for S3/R2 in production via lib/storage.ts).
VAULT_DIR=".vault"

# ---- Extension <-> backend ----
# Public origin the extension is allowed to call.
ALLOWED_EXTENSION_ORIGIN="chrome-extension://<your-extension-id>"
