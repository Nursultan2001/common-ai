# NOTE: this file lives at the repo root for reference, but the app reads
# apps/web/.env (Prisma + Next both load env from there). Put your real values
# in apps/web/.env.

# ---- Database (PostgreSQL) ----
# Get a free Postgres URL from Neon (https://neon.tech) — works for both local
# dev and production. Use the SAME url locally and on Vercel during pre-launch.
# Example: postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Auth ----
AUTH_SECRET="generate-with: openssl rand -base64 32"
APP_URL="http://localhost:3000"

# ---- Anthropic (AI content service) ----
ANTHROPIC_API_KEY="sk-ant-..."
AI_MODEL="claude-opus-4-8"

# ---- Stripe (per-application billing) ----
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PER_APPLICATION_CENTS="500"

# ---- Document vault encryption ----
# 32-byte base64 key for AES-256-GCM. Generate: openssl rand -base64 32
DOC_ENCRYPTION_KEY="..."
# Local document vault directory (swap for S3/R2 in production via lib/storage.ts).
VAULT_DIR=".vault"

# ---- Extension <-> backend ----
# Public origin the extension is allowed to call.
ALLOWED_EXTENSION_ORIGIN="chrome-extension://<your-extension-id>"
