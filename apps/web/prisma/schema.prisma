// Common AI — data model
// Principle: this schema is the SINGLE SOURCE OF TRUTH for an applicant.
// Autofill and AI may ONLY use values that exist here. Anything missing is
// flagged back to the user, never guessed or fabricated.
//
// DB: PostgreSQL (works locally via a hosted DB like Neon, and in production).
// status/role/type fields are Strings whose allowed values are documented in
// comments and enforced in the TypeScript layer (kept this way so the same
// models also run on SQLite for quick local experiments if ever needed).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // App runtime: use the pooled connection (Supabase pooler / Neon pooled).
  url       = env("DATABASE_URL")
  // Migrations & `prisma db push`: a direct (non-pooled) connection.
  // DIRECT_URL must be set. For a non-pooled DB you can set it equal to
  // DATABASE_URL; for Supabase use the port 5432 direct string.
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// Tenancy & identity
// ----------------------------------------------------------------------------

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  role         String       @default("STUDENT") // STUDENT | COUNSELOR | ADMIN
  passwordHash String?
  orgId        String?
  org          Org?         @relation(fields: [orgId], references: [id])
  memberships  Membership[]
  ownedApplicants Applicant[] @relation("ApplicantOwner")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// An agency / counseling organization. Gets discounted per-application pricing.
model Org {
  id          String       @id @default(cuid())
  name        String
  type        String       @default("AGENCY") // AGENCY | SCHOOL
  // Discount applied to base per-application price, in basis points.
  // 1000 = 10% off, 2500 = 25% off. 0 = no discount.
  discountBps Int          @default(0)
  active      Boolean      @default(true)
  users       User[]
  memberships Membership[]
  applicants  Applicant[]
  payments    Payment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  role      String   @default("COUNSELOR") // COUNSELOR | ADMIN
  createdAt DateTime @default(now())

  @@unique([userId, orgId])
}

// ----------------------------------------------------------------------------
// Applicant profile (the source of truth)
// ----------------------------------------------------------------------------

model Applicant {
  id          String   @id @default(cuid())
  ownerUserId String
  owner       User     @relation("ApplicantOwner", fields: [ownerUserId], references: [id])
  orgId       String?
  org         Org?     @relation(fields: [orgId], references: [id])

  profile      MasterProfile?
  activities   Activity[]
  honors       Honor[]
  documents    Document[]
  essays       Essay[]
  applications Application[]
  entitlements Entitlement[]
  parents      Parent[]
  siblings     Sibling[]
  languages    Language[]
  otherSchools OtherSchool[]
  colleges     College[]
  testScores   TestScores?
  courses      Course[]
  gradeReports GradeReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([ownerUserId])
}

// One-to-one core biographical data. Plain fields; null = "not provided yet".
model MasterProfile {
  id          String   @id @default(cuid())
  applicantId String   @unique
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  legalFirstName String?
  middleName     String?
  legalLastName  String?
  suffix         String?  // dropdown: "" | "Jr." | "Sr." | "II" | "III" | "IV" | "V"
  preferredName  String?
  sharePreferredName String? // "Yes" | "No" — share a different first name?
  hasFormerName      String? // "Yes" | "No" — materials under a former legal name?
  formerLastName     String?
  dateOfBirth    DateTime?
  birthCity      String?
  birthCountry   String?
  email          String?
  phone          String?
  phoneType            String? // "Home" | "Mobile"
  phoneCountryCode     String? // e.g. "Kazakhstan" / "+7" (combobox typed value)
  alternatePhone       String? // "No other telephone" | "Home" | "Mobile"
  alternatePhoneNumber String?
  alternatePhoneCountryCode String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  alternateMailingAddress String? // "No alternate address" | "Send mail to a temporary or alternate address"

  citizenship       String?
  citizenshipStatus String? // exact Common App option, e.g. "Citizen of non-U.S. country"
  yearsInUS         String? // "Number of years you have lived in the United States" (dropdown)
  holdsUSVisa       String? // "Yes" | "No"
  intendsUSVisa     String? // "Yes" | "No"
  visaType          String? // e.g. "F-1 Student"
  gender            String? // checkbox(es), comma-separated: "Female" | "Male" | "Nonbinary"
  legalSex          String? // "Female" | "Male" | "X or another legal sex"
  pronouns          String? // checkbox(es), comma-separated: "He/Him" | "She/Her" | "They/Them"
  armedForces       String? // "None" | "Currently Serving" | "Previously Served" | "Current Dependent"
  hispanicLatino    String? // "Yes" | "No"
  raceEthnicity     String? // multi, comma-separated CA labels (American Indian or Alaska Native, Asian, …)

  highSchoolName String?
  graduationYear Int?
  dateOfEntry    DateTime?
  graduationDate DateTime?
  classSize      Int?

  // Current/most recent Secondary/High School page (4/18).
  // Most non-US schools are NOT in Common App's registry, so we fill the
  // "I don't see my high school in this list" manual-entry path.
  highSchoolNotListed String? // "Yes" = not in CA list → manual entry; "No" = pick from list
  highSchoolCountry   String? // Country/Region/Territory (combobox)
  highSchoolType      String? // "Public" | "Charter" | "Religious" | "Home school" | "Independent"
  highSchoolAddress1  String?
  highSchoolAddress2  String?
  highSchoolAddress3  String?
  highSchoolCity      String?
  highSchoolState     String? // combobox (shown for US addresses)
  highSchoolZip       String?
  isBoardingSchool    String? // "Yes" | "No"
  didGraduate         String? // "Yes" | "No" — did/will you graduate from this school?
  progression         String? // multi, comma-separated: "Did or will graduate early" | "...late" | "...take time off" | "...take gap year" | "No change in progression"

  gpa            Float?
  gpaScale       Float?
  classRank      String? // exact rank, shown when reporting = Exact
  classRankReporting String? // Exact | Decile | Quintile | Quartile | None
  decileRank         String? // shown when reporting = Decile
  quintileRank       String? // Top 20% | Top 40% | Top 60% | Top 80% | Top 100% (Quintile)
  quartileRank       String? // Top 25% | Top 50% | Top 75% | Top 100% (Quartile)
  rankWeighting      String? // Weighted | Unweighted (class rank)
  gpaWeighting       String? // Weighted | Unweighted (GPA)
  courseScheduleSystem String? // Semester | Trimester | Quarter | Yearly (Courses page)

  satTotal     Int?
  actComposite Int?

  intendedMajor  String?
  highestDegree  String? // Common App "Highest degree you intend to earn" option
  careerInterest String? // Common App "Career interest" option
  enrollmentPlan String? // Future Plans "Which best describes you?" option

  // Common App Fee Waiver (a certification — the student must truly qualify).
  feeWaiverEligible  String? // "Yes" | "No"
  feeWaiverSignature String? // the student's typed signature (their name)
  ustriveMentor      String? // "Yes" | "No" — connect with a UStrive mentor?

  // Household (5/26)
  parentsMaritalStatus String? // "Married" | "Divorced" | ...
  permanentHomeWith    String? // "Both Parents" | "Parent 1" | ...
  hasChildren          String? // "Yes" | "No"

  // Responsibilities & circumstances (Activities page 7/250) — CSV of the
  // exact Common App option labels the student selected.
  responsibilities String?
  circumstances    String?

  // Additional Information (Writing section). Each Yes/No is derived from whether
  // the student wrote anything in the matching box.
  addlInfoText           String? // challenges/circumstances details
  addlQualificationsText String? // other details/qualifications not reflected elsewhere

  // Courses & Grades transcript section (13/54): can access transcript/grades?
  transcriptAccess String? // "Yes" | "No"

  // My Colleges supplement answers — general, reused across every college.
  // Filled by label (page IDs differ per college), best-effort.
  collegeStartTerm     String? // e.g. "Fall 2026"
  collegeAdmissionPlan String? // "Regular Decision" | "Early Action" | ...
  collegeResidence     String? // "On Campus" | "Off Campus" | "Commuter" | "With family"
  collegeSatActPlan    String? // "Yes" | "No" — did/do you plan to take SAT or ACT?

  // Free-form structured extras the questionnaire collected, stored as JSON
  // text so we can add intake questions without migrations. Still read-only facts.
  extra String?

  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Activities & honors — raw input + AI-polished output (review required)
// status: RAW (entered) | DRAFTED (AI draft) | APPROVED (student approved)
// ----------------------------------------------------------------------------

model Activity {
  id          String   @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  category     String?
  position     String?
  organization String?
  gradeLevels  String?
  timing       String?
  hoursPerWeek Int?
  weeksPerYear Int?
  collegeIntent String? // "Yes" | "No" — intend to continue in college

  rawDescription      String
  polishedDescription String?
  status              String @default("RAW") // RAW | DRAFTED | APPROVED

  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([applicantId])
}

model Honor {
  id          String   @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  title       String
  gradeLevels String?
  level       String?

  rawDescription String
  polishedTitle  String?
  status         String @default("RAW") // RAW | DRAFTED | APPROVED

  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([applicantId])
}

// ----------------------------------------------------------------------------
// Essays — COACHING flow. AI drafts from the student's real stories; the
// student rewrites in their own voice and attests authorship at submit time.
// kind: PERSONAL_STATEMENT | SUPPLEMENT | WHY_SCHOOL | ACTIVITY_ELABORATION | OTHER
// ----------------------------------------------------------------------------

model Essay {
  id          String   @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  kind        String  @default("PERSONAL_STATEMENT")
  prompt      String?
  wordLimit   Int?

  studentNotes String?
  outline      String?
  draft        String?
  finalText    String?
  status       String  @default("RAW") // RAW | DRAFTED | APPROVED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicantId])
}

// ----------------------------------------------------------------------------
// Document vault — encrypted at rest, decrypted only for the owner's session
// type: TRANSCRIPT | TEST_SCORE_REPORT | FINANCIAL_AID | PASSPORT_ID | RESUME | PORTFOLIO | OTHER
// ----------------------------------------------------------------------------

model Document {
  id          String   @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  type        String
  fileName    String
  mimeType    String
  sizeBytes   Int

  storageKey  String
  iv          String
  authTag     String

  createdAt DateTime @default(now())

  @@index([applicantId])
}

// ----------------------------------------------------------------------------
// Universities, applications, entitlements, payments
// ----------------------------------------------------------------------------

model University {
  id            String       @id @default(cuid())
  name          String       @unique
  portalType    String       @default("COMMON_APP") // COMMON_APP | COALITION | DIRECT
  supplementUrl String?
  fieldMapKey   String?
  applications  Application[]
  createdAt     DateTime     @default(now())
}

model Application {
  id           String   @id @default(cuid())
  applicantId  String
  applicant    Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  universityId String
  university   University @relation(fields: [universityId], references: [id])

  status      String       @default("DRAFT") // DRAFT | READY_FOR_REVIEW | SUBMITTED_BY_STUDENT
  entitlement Entitlement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicantId, universityId])
  @@index([applicantId])
}

// One paid unlock = one university application's assisted autofill.
// status: LOCKED | PAID | REFUNDED
model Entitlement {
  id            String   @id @default(cuid())
  applicantId   String
  applicant     Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  applicationId String   @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  status         String  @default("LOCKED")
  priceCents     Int
  basePriceCents Int
  discountBps    Int     @default(0)
  paymentId      String?
  payment        Payment? @relation(fields: [paymentId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicantId])
}

// status: PENDING | SUCCEEDED | FAILED | REFUNDED
model Payment {
  id          String   @id @default(cuid())
  payerUserId String?
  orgId       String?
  org         Org?     @relation(fields: [orgId], references: [id])

  amountCents Int
  currency    String   @default("usd")
  status      String   @default("PENDING")

  stripeSessionId       String?  @unique
  stripePaymentIntentId String?  @unique

  entitlements Entitlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
  @@index([payerUserId])
}

// ----------------------------------------------------------------------------
// Family — parents/guardians and siblings (separate people from the applicant)
// ----------------------------------------------------------------------------

model Parent {
  id          String   @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  order          Int    @default(0) // 0 = Parent 1, 1 = Parent 2
  relationship   String? // Mother | Father | Guardian ...
  parentType     String? // "Mother" | "Father" | "I have limited information about this parent"
  isLiving       String? // "Yes" | "No"
  prefix         String? // Mr. | Mrs. | Ms. | Dr. ...
  firstName      String?
  middleInitial  String?
  lastName       String?
  suffix         String?
  formerLastName String?
  email          String?
  phoneType      String? // "Mobile" | "Home" | "Other" | "Work"
  phoneCountryCode String?
  phoneNumber      String?
  occupation       String?
  occupationOther  String?
  employmentStatus String? // Employed | Self-Employed | Retired | ...
  educationLevel   String? // "Some high/secondary school" | "Bachelor's degree" | ...
  parentCollegeEmployment  String? // "Currently employed at a college/university" | "Retired from a college/university" | "Not employed at a college/university"
  parentInstitutionsAttended String? // "1".."5"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicantId, order])
  @@index([applicantId])
}

model Sibling {
  id          String   @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  order      Int     @default(0)
  firstName  String?
  lastName   String?
  ageOrGrade String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicantId])
}

// ----------------------------------------------------------------------------
// Languages — proficiency (repeating; Common App allows up to 5)
// ----------------------------------------------------------------------------

// Additional secondary/high schools (Common App "Other Secondary/High Schools",
// page 4/19). Same manual-entry questions as the main school, repeated per row,
// plus from/to dates and a per-school reason for leaving.
model OtherSchool {
  id          String   @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  order     Int     @default(0)
  name      String?
  notListed String? // "Yes" = not in CA list → manual entry; "No" = pick from list
  country   String?
  type      String? // "Public" | "Charter" | "Religious" | "Home school" | "Independent"
  address1  String?
  address2  String?
  address3  String?
  city      String?
  state     String?
  zip       String?
  fromDate  DateTime?
  toDate    DateTime?
  reasonLeft String? // why the student left this school

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicantId, order])
  @@index([applicantId])
}

// Colleges/universities where the student took coursework (Common App
// "Colleges & Universities", page 4/21). Same manual-entry path as schools when
// the college isn't in CA's registry, plus course-detail flags, dates, degree.
model College {
  id          String   @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  order     Int     @default(0)
  name      String?
  notListed String? // "Yes" = not in CA list → manual entry
  country   String?
  address1  String?
  address2  String?
  address3  String?
  city      String?
  state     String?
  zip       String?
  // checked "Course details", comma-separated:
  // "Dual enrollment with high school" | "Summer program" | "Credit awarded directly by college"
  courseDetails String?
  fromDate    DateTime?
  toDate      DateTime?
  degreeEarned String? // "AA" | "AS" | "BA" | "BS"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicantId, order])
  @@index([applicantId])
}

// Courses & Grades transcript section (Common App pages 13/55–13/58, one per
// grade 9–12). Each grade has a transcript header (school/year/scale/schedule)
// and a list of courses entered in the modal grid. One transcript per grade.
model GradeReport {
  id          String   @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  grade        String  // "9" | "10" | "11" | "12"
  schoolName   String?
  schoolYear   String? // e.g. "2024-25"
  gradingScale String? // "A-F" | "1-100" | "0.0-4.0" | "0.0-5.0" | "1-7" | "1-10" | "1-11" | "1-20" | "Other"
  schedule     String? // "Semesters" | "Trimesters" | "Quarters" | "Yearly" | "Other"
  reportedAll  Boolean @default(false)

  courses GradeCourse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([applicantId, grade])
  @@index([applicantId])
}

model GradeCourse {
  id            String @id @default(cuid())
  gradeReportId String
  report        GradeReport @relation(fields: [gradeReportId], references: [id], onDelete: Cascade)

  order       Int     @default(0)
  subject     String? // one of the Common App subject options
  courseName  String?
  courseLevel String? // one of the Common App course-level options

  createdAt DateTime @default(now())

  @@index([gradeReportId])
}

model Language {
  id          String   @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  order       Int     @default(0)
  name        String?
  // checked proficiency options, comma-separated:
  // "First Language" | "Speak" | "Read" | "Write" | "Spoken at Home"
  proficiency String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicantId])
}

// ----------------------------------------------------------------------------
// Testing — self-reported scores (IELTS-focused for now; one row per applicant)
// ----------------------------------------------------------------------------

model TestScores {
  id          String   @id @default(cuid())
  applicantId String   @unique
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  selfReportScores String? // "Yes" | "No"
  internationalLeavingExam String? // "Yes" | "No" (intl promotion by leaving exams)
  testsToReport String? // CSV of CA test options (ACT Tests, SAT Tests, IELTS, …)

  // IELTS — one date applied to all sub-scores for simplicity.
  ieltsTimesTaken Int?
  ieltsListening  String?
  ieltsReading    String?
  ieltsWriting    String?
  ieltsSpeaking   String?
  ieltsOverall    String?
  ieltsDate       DateTime?

  // SAT (page 2/236): EBRW + Math (200–800), optional Essay (combined 6–24).
  satPastCount         String?  // 0–5 (dropdown)
  satFutureSittings    String?  // 0–3 (radio)
  satFutureDate1       DateTime?
  satFutureDate2       DateTime?
  satFutureDate3       DateTime?
  satReadingWriting    String?  // Highest Evidence-Based Reading & Writing
  satReadingWritingDate DateTime?
  satMath              String?  // Highest Math
  satMathDate          DateTime?
  satEssayReport       String?  // "Yes" | "No" — report a combined essay score?
  satEssay             String?  // Highest combined essay score (6–24)
  satEssayDate         DateTime?

  // ACT (page 2/3). Scores stored as strings (the form uses dropdowns).
  actPastCount      String?   // 0–5 (radio)
  actComposite      String?   // 1–36
  actCompositeDate  DateTime?
  actEnglish        String?
  actEnglishDate    DateTime?
  actMath           String?
  actMathDate       DateTime?
  actReading        String?
  actReadingDate    DateTime?
  actReportScience  String?   // Yes/No
  actScience        String?
  actScienceDate    DateTime?
  actReportWriting  String?   // Yes/No
  actWriting        String?   // 2–12
  actWritingDate    DateTime?
  actFutureSittings String?   // 0–3 (radio)

  // Senior Secondary Leaving Examinations
  ssleCount Int?

  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Courses & grades — current/senior-year course list (Common App "Courses")
// ----------------------------------------------------------------------------

model Course {
  id          String   @id @default(cuid())
  applicantId String
  applicant   Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  order    Int     @default(0)
  subject  String?
  name     String?
  level    String? // e.g. Regular, Honors, AP, IB
  schedule String? // e.g. Full Year, Semester 1

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicantId])
}

// ----------------------------------------------------------------------------
// Dev-only: raw page-structure dumps from the deep scraper (no personal data,
// only field structure). Used to build the field map. Safe to drop later.
// ----------------------------------------------------------------------------

model ScrapeDump {
  path      String   @id
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------------------------------
// Audit log — admin visibility into every AI generation & autofill action
// ----------------------------------------------------------------------------

model AuditEvent {
  id          String   @id @default(cuid())
  action      String   // AI_POLISH_ACTIVITY | AI_POLISH_HONOR | AI_DRAFT_ESSAY | AUTOFILL_SERVED | ENTITLEMENT_GRANTED | PAYMENT_SUCCEEDED | DOCUMENT_UPLOADED
  userId      String?
  applicantId String?
  meta        String?  // JSON text
  createdAt   DateTime @default(now())

  @@index([applicantId])
  @@index([action])
}

// ----------------------------------------------------------------------------
// Waitlist — pre-launch email capture
// ----------------------------------------------------------------------------

model WaitlistEntry {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  audience    String    @default("STUDENT") // STUDENT | COUNSELOR
  note        String?
  source      String?   // where they signed up from
  invited     Boolean   @default(false)
  invitedAt   DateTime?
  inviteToken String?   @unique // single-use token that unlocks /signup
  createdAt   DateTime  @default(now())

  @@index([createdAt])
}
