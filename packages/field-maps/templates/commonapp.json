{
  "key": "common-app-core",
  "portal": "COMMON_APP",
  "version": 3,
  "_note": "Built from real captures of apply.commonapp.org. Selectors are Common App's stable question IDs (#text_ques_NNN) with a label fallback. Only HIGH-CONFIDENCE applicant fields are mapped. Deliberately omitted: Date of birth (text field expects MM/DD/YYYY; needs a formatter), all radios/dropdowns (need value maps), and Family/Activities/Writing pages (out of current data model). See docs/COMMONAPP-SELECTORS.md and captures/ for the raw data.",
  "pages": [
    {
      "urlPattern": "https://apply.commonapp.org/common/3/11*",
      "name": "Personal information — name",
      "fields": [
        { "source": "profile.legalFirstName", "selectors": ["#text_ques_173", "label:Legal first"], "kind": "text" },
        { "source": "profile.legalLastName", "selectors": ["#text_ques_175", "label:Last/family"], "kind": "text" }
      ]
    },
    {
      "urlPattern": "https://apply.commonapp.org/common/3/17*",
      "name": "Citizenship",
      "fields": [
        { "source": "profile.citizenship", "selectors": ["#text_ques_236", "label:List countries of citizenship"], "kind": "text", "requiresConfirm": true }
      ]
    },
    {
      "urlPattern": "https://apply.commonapp.org/common/4/23*",
      "name": "Education — GPA",
      "fields": [
        { "source": "profile.gpa", "selectors": ["#text_ques_304", "label:Cumulative GPA"], "kind": "text", "requiresConfirm": true },
        { "source": "profile.gpaScale", "selectors": ["#text_ques_305", "label:GPA Scale"], "kind": "text", "requiresConfirm": true }
      ]
    }
  ]
}
