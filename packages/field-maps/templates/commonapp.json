{
  "key": "common-app-core",
  "portal": "COMMON_APP",
  "version": 1,
  "_note": "Selectors below are REPRESENTATIVE placeholders. Common App's real DOM uses dynamic/obfuscated attributes and changes over time. Each selector must be verified against the live page and updated via the admin field-map editor. Treat unverified selectors as low-confidence (extension routes them to the AI fallback + human review).",
  "pages": [
    {
      "urlPattern": "https://apply.commonapp.org/*profile*",
      "name": "Profile — Personal Information",
      "fields": [
        {
          "source": "profile.legalFirstName",
          "selectors": ["#firstName", "input[name='legalFirstName']"],
          "kind": "text"
        },
        {
          "source": "profile.legalLastName",
          "selectors": ["#lastName", "input[name='legalLastName']"],
          "kind": "text"
        },
        {
          "source": "profile.preferredName",
          "selectors": ["#preferredName", "input[name='preferredName']"],
          "kind": "text"
        },
        {
          "source": "profile.dateOfBirth",
          "selectors": ["#dob", "input[name='dateOfBirth']"],
          "kind": "date",
          "requiresConfirm": true
        },
        {
          "source": "profile.email",
          "selectors": ["#email", "input[type='email']"],
          "kind": "email"
        },
        {
          "source": "profile.phone",
          "selectors": ["#phone", "input[name='phoneNumber']"],
          "kind": "tel"
        }
      ]
    },
    {
      "urlPattern": "https://apply.commonapp.org/*address*",
      "name": "Profile — Address",
      "fields": [
        {
          "source": "profile.addressLine1",
          "selectors": ["#addressLine1", "input[name='street1']"],
          "kind": "text"
        },
        {
          "source": "profile.addressLine2",
          "selectors": ["#addressLine2", "input[name='street2']"],
          "kind": "text"
        },
        {
          "source": "profile.city",
          "selectors": ["#city", "input[name='city']"],
          "kind": "text"
        },
        {
          "source": "profile.state",
          "selectors": ["#state", "select[name='state']"],
          "kind": "select"
        },
        {
          "source": "profile.postalCode",
          "selectors": ["#zip", "input[name='postalCode']"],
          "kind": "text"
        },
        {
          "source": "profile.country",
          "selectors": ["#country", "select[name='country']"],
          "kind": "select"
        }
      ]
    },
    {
      "urlPattern": "https://apply.commonapp.org/*education*",
      "name": "Education",
      "fields": [
        {
          "source": "profile.highSchoolName",
          "selectors": ["#highSchool", "input[name='currentSchool']"],
          "kind": "text",
          "requiresConfirm": true
        },
        {
          "source": "profile.graduationYear",
          "selectors": ["#gradYear", "select[name='graduationYear']"],
          "kind": "select"
        },
        {
          "source": "profile.gpa",
          "selectors": ["#gpa", "input[name='cumulativeGPA']"],
          "kind": "number",
          "requiresConfirm": true
        }
      ]
    },
    {
      "urlPattern": "https://apply.commonapp.org/*activities*",
      "name": "Activities",
      "repeating": [
        {
          "source": "activities",
          "addButtonSelector": "button[data-testid='add-activity']",
          "rowSelector": "[data-testid='activity-row']",
          "fields": [
            {
              "source": "category",
              "selectors": ["select[name='activityType']"],
              "kind": "select"
            },
            {
              "source": "position",
              "selectors": ["input[name='position']"],
              "kind": "text"
            },
            {
              "source": "organization",
              "selectors": ["input[name='organization']"],
              "kind": "text"
            },
            {
              "source": "description",
              "selectors": ["textarea[name='description']"],
              "kind": "textarea"
            },
            {
              "source": "hoursPerWeek",
              "selectors": ["input[name='hoursPerWeek']"],
              "kind": "number"
            },
            {
              "source": "weeksPerYear",
              "selectors": ["input[name='weeksPerYear']"],
              "kind": "number"
            }
          ]
        }
      ],
      "fields": []
    },
    {
      "urlPattern": "https://apply.commonapp.org/*honors*",
      "name": "Honors",
      "repeating": [
        {
          "source": "honors",
          "addButtonSelector": "button[data-testid='add-honor']",
          "rowSelector": "[data-testid='honor-row']",
          "fields": [
            {
              "source": "title",
              "selectors": ["input[name='honorTitle']"],
              "kind": "text"
            },
            {
              "source": "level",
              "selectors": ["select[name='recognitionLevel']"],
              "kind": "select"
            }
          ]
        }
      ],
      "fields": []
    }
  ]
}
